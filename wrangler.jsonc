// Налаштування Cloudflare Worker для Car Check.
// Сайт — статичні файли з кореня репозиторію, бекенд — worker/index.js (/api/analyze).
// Секрет ANTHROPIC_API_KEY задається в Cloudflare: Settings → Variables and Secrets.
{
  "name": "car-check",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  // Обмеження кількості аналізів (див. worker/limiter.js)
  "durable_objects": {
    "bindings": [{ "name": "LIMITER", "class_name": "RateLimiter" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RateLimiter"] }],
  // Не стирати змінні, додані в панелі Cloudflare (наприклад, CLAUDE_MODEL), при кожному деплої
  "keep_vars": true,
  "observability": { "enabled": true }
}
