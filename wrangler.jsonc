// Налаштування Cloudflare Worker для Car Check.
// Сайт — статичні файли з кореня репозиторію, бекенд — worker/index.js (/api/analyze).
// Секрет ANTHROPIC_API_KEY задається в Cloudflare: Settings → Variables and Secrets.
{
  "name": "car-check",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  // .md-файли (prompts/rules.md) імпортуються в код як текст
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  // Обмеження кількості аналізів (worker/limiter.js) і кеш результатів (worker/cache.js)
  "durable_objects": {
    "bindings": [
      { "name": "LIMITER", "class_name": "RateLimiter" },
      { "name": "ANALYSIS_CACHE", "class_name": "AnalysisCache" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RateLimiter"] },
    { "tag": "v2", "new_sqlite_classes": ["AnalysisCache"] }
  ],
  // Не стирати змінні, додані в панелі Cloudflare (наприклад, CLAUDE_MODEL), при кожному деплої
  "keep_vars": true,
  "observability": { "enabled": true }
}
